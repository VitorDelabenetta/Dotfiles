/*█▀█ █▀█ ▀█▀ █ █▀█ █▄ █ █▀ 
  █▄█ █▀▀  █  █ █▄█ █ ▀█ ▄█*/

{
  "position": "top",
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": [],
  "modules-right": ["network", "pulseaudio", "cpu", "memory", "battery", "clock"],

  "hyprland/window": {
    "format": "{initialTitle}"
  },

  "clock": {
    "format": "<span foreground='#FFEBE8'> </span>{:%a, %B %d [%H:%M]}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#FFEBE8'><b>{}</b></span>",
        "weekdays": "<span color='#FFEBE8'><b>{}</b></span>",
        "days": "<span color='#FFEBE8'><b>{}</b></span>",
        "today": "<span color='#FFEBE8'><b><u>{}</u></b></span>"
      }
    }
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='13000' foreground='#FFEBE8'>{icon}</span> {capacity}%",
    "format-warning": "<span size='13000' foreground='#FFEBE8'>{icon}</span> {capacity}%",
    "format-critical": "<span size='13000' foreground='#FFEBE8'>{icon}</span> {capacity}%",
    "format-charging": "<span size='13000' foreground='#FFEBE8'> </span>{capacity}%",
    "format-plugged": "<span size='13000' foreground='#FFEBE8'> </span>{capacity}%",
    "format-alt": "<span size='13000' foreground='#FFEBE8'>{icon}</span> {time}",
    "format-full": "<span size='13000' foreground='#FFEBE8'> </span>{capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time}"
  },

  "memory": {
    "format": "<span size='13000' foreground='#FFEBE8'></span> {used:0.1f}G/{total:0.1f}G",
    "interval": 5
  },

  "cpu": {
    "states": {
      "warning": 45,
      "critical": 60
    },
    "format": "<span size='13000' foreground='#FFEBE8'>󰍛</span> {usage}%",
    "format-warning": "<span size='13000' foreground='#FFEBE8'>󰍛</span> {usage}%",
    "format-critical": "<span size='13000' foreground='#FFEBE8'>󰍛</span> {usage}%",
    "interval": 5
  },

  "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": " mute",
      "format-icons": {
          "default": ["", "", " "]
      },
      "on-click": "pactl set-sink-mute 0 toggle"
  },

  "network": {
    "format-wifi": "<span size='13000' foreground='#FFEBE8'>  </span>{essid}",
    "format-ethernet": "<span size='13000' foreground='#FFEBE8'>  </span> Disconnected",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "<span size='13000' foreground='#FFEBE8'>󰤭  </span> Offline",
    "tooltip-format-wifi": "Signal Strenght: {signalStrength}%",
    "on-click-right": "nmcli radio wifi off",
    "on-click": "nmcli radio wifi on" 
  }
}
