{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    
    "logo": {
        "type": "small",
	"padding": {
            "right": 2,
	    "left": 2,
	    "top": 4
        }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
	"break",
        {
            "type": "custom",
            "format": "\u001b[36m Eat  , Sleep  , Linux  "
        },
        {
            "type": "custom",
            "format": "┌───────────────────────────────────────┐"
        },
        {
            "type": "os",
            "format": "{2} {9}",
            "key": "   System",
            "keyColor": "35"
        },
        {
            "type": "host",
	    "format": "{2}",
            "key": " 󰍹  Laptop",
            "keyColor": "35"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "   CPU",
            "keyColor": "35"
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": " 󰊴  GPU",
            "keyColor": "35"
        },
        {
            "type": "memory",
            "key": "   Memory",
            "format": "{1} / {2}",
            "keyColor": "35"
        },      
        {
            "type": "disk",
            "key": " 󰋊  Disk",
            "format": "{1} / {2} [{3}]",
            "keyColor": "35"
        },
        {
            "type": "custom",
            "format": "└───────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "┌───────────────────────────────────────┐"
        },
        {
            "type": "uptime",
            "key": " 󱫐  Uptime ",
            "keyColor": "36"
        },
        {
            "type": "command",
            "key": " 󱦟  Age",
            "keyColor": "36",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "custom",
            "format": "└───────────────────────────────────────┘"
        },
	{
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
        
    ]
}
